  m_Script: {fileID: 11500000, guid: 2314216386f93e848b802d3e5aa8e609, type: 3}
  m_Name: TyphoidFever
  m_EditorClassIdentifier: Assembly-CSharp::MedicalCase
  title: Typhoid Fever
  type: Common
  category: Infectious - Bacterial
  description: A bacterial infection caused by Salmonella typhi, transmitted through
    contaminated food and water.
  symptoms: "Fever persisting for 5 days or more, typically >38\xB0C.   Headache,
    body malaise, and anorexia (loss of appetite).   Gastrointestinal symptoms including
    abdominal pain, nausea, vomiting, and diarrhea.  "
  pathology: Exposure is linked to poor sanitation, intermittent water supply, and
    street food consumption.
  treatment: 'Uncomplicated cases are treated with Azithromycin 500 mg once daily
    for 7 days.   Supportive care with oral hydration.   Diagnosis should be confirmed
    via blood culture (the Widal test is no longer recommended). '
  keyFeatures: A fever persisting for 5 or more days combined with gastrointestinal
    symptoms is the classic clinical presentation.
  requiredStageLevel: 1
