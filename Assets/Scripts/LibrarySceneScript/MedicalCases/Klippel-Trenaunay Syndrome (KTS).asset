  m_Name: Klippel-Trenaunay Syndrome (KTS)
  m_EditorClassIdentifier: Assembly-CSharp::MedicalCase
  caseImage1: {fileID: -467814268085375519, guid: 62a089e6ccf996a4297c9b2a56a54c16, type: 3}
  caseImage2: {fileID: -2365651026945344698, guid: 6788fe8cf1d85e049ac4d3b61eb08e14, type: 3}
  title: Klippel-Trenaunay Syndrome (KTS)
  type: Uncommon
  category: Vascular Disorder / Congenital
  description: A rare condition characterized by port-wine stains, leg overgrowth,
    and vascular changes.
  symptoms: 'Port-wine stain (capillary malformation).   Left limb length-girth discrepancy
    (overgrowth).   Skin warmth and fever if inflamed. '
  pathology: Associated with RAD50 and POLE gene mutations.
  treatment: 'Targeted therapy with Sirolimus to calm abnormal blood vessels and
    reduce overgrowth.   Ultrasound of the leg and genetic testing to confirm mutations. '
  keyFeatures: The classic triad includes capillary malformations, venous or lymphatic
    malformations, and soft tissue and bone hypertrophy.
  requiredStageLevel: 1
