  m_Script: {fileID: 11500000, guid: 2314216386f93e848b802d3e5aa8e609, type: 3}
  m_Name: Leptospirosis
  m_EditorClassIdentifier: Assembly-CSharp::MedicalCase
  caseImage1: {fileID: -6366081592632494656, guid: 34358e9960723fd4988e14a246ef916c, type: 3}
  caseImage2: {fileID: -4947013683145954308, guid: 43f85cdf306b89c4a84e495ba60c9e3c, type: 3}
  title: Leptospirosis (Weil Syndrome)
  type: Common / Emergency
  category: Infectious - Bacterial
  description: A bacterial infection caused by Leptospira bacteria, which enters
    the body through cuts and wounds exposed to contaminated water, such as floodwater.
    The severe form, known as Weil syndrome, carries a 5-15% mortality rate.
  symptoms: "High fever (e.g., 39.5\xB0C) and mild abdominal pain.   Severe myalgia
    (muscle aches), especially in the calves and back.   Conjunctival suffusion (bloodshot/red
    eyes).   Jaundice (yellowish tint to skin and eyes) and oliguria (decreased urine
    output).  "
  pathology: The bacteria is often found in the urine of infected animals, especially
    rats. The infection can rapidly progress to multi-organ failure (especially kidney
    and liver involvement) within days if left untreated
  treatment: 'mmediate hospital admission for close monitoring of kidney and liver
    function.   Administration of IV antibiotics such as Penicillin G or Doxycycline.  
    Financial assistance like PhilHealth can cover moderate to severe cases, including
    those requiring hemodialysis.   '
  keyFeatures: he classic clinical picture involves fever, jaundice, red eyes, and
    kidney failure following exposure to floodwater with an open wound.
  requiredStageLevel: 0
