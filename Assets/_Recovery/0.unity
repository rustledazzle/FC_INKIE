  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialPanel: {fileID: 1057234025}
  tutorialText: {fileID: 1995343176}
  tutorialImage: {fileID: 665226648}
  nextButton: {fileID: 1056615037}
  closeButton: {fileID: 321150606}
  pages:
  - 'Orientation Shift (Tutorial)

    Welcome to First Contact. In this introductory
    shift, you will learn the fundamental controls, how to navigate the clinic, and
    the core mechanics of a patient consultation. Complete this orientation to receive
    your first badge and unlock your scheduled clinical cases.'
  - 'Interactive Tutorial Module

    The tutorial level serves as a comprehensive
    onboarding experience for medical students and players. It familiarizes users
    with the WASD movement controls, the interactive UI, and the dialogue-based consultation
    system. It also introduces the four core grading metrics used throughout the
    simulation: Clinical Reasoning, Information Gathering, Empathy, and Patient Safety.'
  pageImages:
  - {fileID: -1478952539, guid: cdbd123bb32916449a17b2e59ae28651, type: 3}
  - {fileID: -4303382692818452729, guid: 9c083d170ca35934c99021a238eefc96, type: 3}
